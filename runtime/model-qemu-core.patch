+/* ==== 本项目插入：物理内存写观察点 ====
+ * 目的：定位固件对某个 RAM 地址的写入者（RAM 写入不经过设备模型，故打在公共写路径上）。
+ * 用法：环境变量 Z8_WATCH=lo-hi（十六进制，半开区间），例如 Z8_WATCH=a03bc1ea4-a03bc1ea8
+ * 默认关闭；未设置时只有一次 getenv 的开销。
+ */
+static uint64_t z8_watch_lo, z8_watch_hi;
+static uint64_t z8_watch_off;
+static bool z8_watch_off_valid;
+static bool z8_watch_inited;
+
+static void z8_watch_init(void)
+{
+    const char *e = getenv("Z8_WATCH");
+    unsigned long long lo = 0, hi = 0;
+    z8_watch_inited = true;
+    if (e && *e && sscanf(e, "%llx-%llx", &lo, &hi) == 2 && hi > lo) {
+        z8_watch_lo = lo;
+        z8_watch_hi = hi;
+        fprintf(stderr, "Z8WATCH armed 0x%llx-0x%llx\n", lo, hi);
+        fflush(stderr);
+    }
+    const char *o = getenv("Z8_WATCH_OFF");
+    if (o && *o) {
+        unsigned long long off = 0;
+        if (sscanf(o, "%llx", &off) == 1) {
+            z8_watch_off = off & 0xfff;
+            z8_watch_off_valid = true;
+            fprintf(stderr, "Z8WATCH page-offset mode 0x%llx\n", z8_watch_off);
+            fflush(stderr);
+        }
+    }
+}
+
+static void z8_watch_check(hwaddr addr, const void *buf, hwaddr len)
+{
+    if (!z8_watch_inited) {
+        z8_watch_init();
+    }
+    if (z8_watch_off_valid) {
+        if ((addr & 0xfff) != z8_watch_off) {
+            return;
+        }
+    } else if (!z8_watch_hi || addr >= z8_watch_hi || addr + len <= z8_watch_lo) {
+        return;
+    }
+    CPUState *cs = current_cpu;
+    uint64_t pc = (cs && cs->cc && cs->cc->get_pc) ? (uint64_t)cs->cc->get_pc(cs) : 0;
+    uint64_t val = 0;
+    if (len <= 8) {
+        memcpy(&val, buf, len);
+    }
+    fprintf(stderr, "Z8WATCH cpu=%d pc=0x%" PRIx64 " addr=0x%" HWADDR_PRIx
+            " len=%" HWADDR_PRIu " value=0x%" PRIx64 "\n",
+            cs ? cs->cpu_index : -1, pc, addr, len, val);
+    fflush(stderr);
+}
+
 static MemTxResult flatview_write(FlatView *fv, hwaddr addr, MemTxAttrs attrs,
                                   const void *buf, hwaddr len);
 static bool flatview_access_valid(FlatView *fv, hwaddr addr, hwaddr len,
@@ -3319,6 +3376,8 @@
     if (!flatview_access_allowed(mr, attrs, mr_addr, l)) {
         return MEMTX_ACCESS_ERROR;
