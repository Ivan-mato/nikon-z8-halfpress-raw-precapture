+/* ==== 本项目插入：存储观察点（RAM/MMIO 都经过 do_st_N）====
+ * 用途：定位固件对指定【虚拟】地址的写入指令。环境变量 Z8_WATCH=lo-hi（十六进制，半开区间）。
+ * ra 在 AArch64 上就是触发该存储的 guest 指令地址，比取当前 PC 更准。默认关闭。
+ */
+static uint64_t z8_st_lo, z8_st_hi;
+static bool z8_st_inited;
+static uint64_t z8_st_hits;
+static uint64_t z8_st_off;
+static bool z8_st_off_valid;
+
+static inline void z8_st_watch2(CPUState *cpu, uint64_t vaddr, uint64_t phys,
+                                uint64_t val, unsigned size, uintptr_t ra);
+
+static inline void z8_st_watch(CPUState *cpu, uint64_t addr, uint64_t val,
+                               unsigned size, uintptr_t ra)
+{
+    if (!z8_st_inited) {
+        const char *e = getenv("Z8_WATCH");
+        unsigned long long lo = 0, hi = 0;
+        z8_st_inited = true;
+        if (e && *e && sscanf(e, "%llx-%llx", &lo, &hi) == 2 && hi > lo) {
+            z8_st_lo = lo; z8_st_hi = hi;
+            fprintf(stderr, "Z8STWATCH armed 0x%llx-0x%llx\n", lo, hi);
+            fflush(stderr);
+        }
+        const char *o = getenv("Z8_WATCH_OFF");
+        if (o && *o) {
+            unsigned long long off = 0;
+            if (sscanf(o, "%llx", &off) == 1) {
+                z8_st_off = off & 0xfff;
+                z8_st_off_valid = true;
+                fprintf(stderr, "Z8STWATCH page-offset mode 0x%llx\n", z8_st_off);
+                fflush(stderr);
+            }
+        }
+    }
+    if (z8_st_off_valid) {
+        if ((addr & 0xfff) != z8_st_off) {
+            return;
+        }
+    } else if (!z8_st_hi || addr >= z8_st_hi || addr + size <= z8_st_lo) {
+        return;
+    }
+    (void)0;
+    z8_st_hits++;
+    fprintf(stderr, "Z8STWATCH n=%" PRIu64 " cpu=%d ra=0x%" PRIx64 " addr=0x%" PRIx64
+            " size=%u value=0x%" PRIx64 "\n",
+            z8_st_hits, cpu ? cpu->cpu_index : -1, (uint64_t)ra, addr, size, val);
+    fflush(stderr);
+}
